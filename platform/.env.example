###############################################
# Yemen Services Platform — environment sample #
# Copy to .env and fill real values on the VPS. #
###############################################

APP_NAME="Yemen Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yemenservices.example
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Aden

# --- Reverse proxy -------------------------------------------------------
# All proxies are trusted (Render/Cloudflare terminate TLS in front of the app);
# see bootstrap/app.php. No TRUSTED_PROXIES variable is read any more.

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (MySQL 8) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yemen_services
DB_USERNAME=yemen_app
DB_PASSWORD=

# --- Redis (cache + queue + session) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Set true behind HTTPS in production; local HTTP development must use false.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Sanctum / SPA ---
# Optional extra domains; the APP_URL and RENDER_EXTERNAL_URL hosts are always
# added automatically, so the Render service domain works out of the box.
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=.yemenservices.example

# --- OTP / passwordless auth ---
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_CHANNEL_DEFAULT=email      # email | whatsapp | sms
OTP_CHANNEL_EMAIL_ENABLED=true
OTP_CHANNEL_WHATSAPP_ENABLED=false
OTP_CHANNEL_SMS_ENABLED=false

# --- SMTP / email OTP ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yemenservices.example
MAIL_FROM_NAME="Yemen Services"

# Render free web services block outbound SMTP (ports 25/465/587). Set a Resend
# key and verification emails go over HTTPS instead; MAIL_FROM_ADDRESS must be a
# verified Resend sender. See https://resend.com/api-keys
RESEND_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_OTP=otp_login
WHATSAPP_BUSINESS_NUMBER=967774274848     # used to build wa.me deep links for dispatch
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- SMS gateway (local aggregator, generic HTTP) ---
SMS_DRIVER=http
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=YemenSvc

# --- n8n automation ---
N8N_WEBHOOK_DISPATCH_URL=
N8N_WEBHOOK_B2B_URL=
DISPATCH_SLA_MINUTES=10
N8N_WEBHOOK_SECRET=

# --- Outbound webhook signing (for endpoints registered in the admin suite) ---
WEBHOOK_SIGNING_ALGO=sha256

# --- Pricing engine defaults ---
PLATFORM_COMMISSION_PERCENT=12
WALLET_MIN_FLOAT_YER=5000
PRICING_CURRENCY=YER
PRICING_VAT_PERCENT=0
PRICING_URGENT_SURCHARGE_PERCENT=25
PRICING_MIN_ORDER_YER=2000

# --- Rate limits (requests / minute) ---
RATELIMIT_API=90
RATELIMIT_OTP_REQUEST=5
RATELIMIT_BOOKING=20
RATELIMIT_ADMIN=240
RATELIMIT_HOME=120

# --- Seed accounts (first deploy only) ---
SEED_ADMIN_PHONE=+967700000001
SEED_ADMIN_EMAIL=admin@yemenservices.example
SEED_ADMIN_PASSWORD=
SEED_DISPATCHER_PHONE=+967700000002

# --- Frontend (Vite) ---
VITE_APP_NAME="${APP_NAME}"
